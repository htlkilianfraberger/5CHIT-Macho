@page "/"
@rendermode InteractiveServer
@using Factory.Models
@using Factory.Services
@inject SmartHomeService SmartHome

<PageTitle>Smart Home Dashboard</PageTitle>

<main class="dashboard-shell">
    <section class="dashboard-header">
        <div>
            <p class="eyebrow">Virtual Factory Method Pattern</p>
            <h1>Smart Home Dashboard</h1>
        </div>
        <div class="device-count">
            <span>@SmartHome.Devices.Count</span>
            <small>Devices</small>
        </div>
    </section>

    <section class="control-grid">
        <form class="panel add-device-panel" @onsubmit="AddDevice" @onsubmit:preventDefault>
            <h2>Add Device</h2>
            <label for="device-name">Device name</label>
            <input id="device-name" type="text" placeholder="Living Room Light" @bind="deviceName" />

            <label for="device-type">Device type</label>
            <select id="device-type" @bind="selectedDeviceType">
                @foreach (string type in SmartHome.DeviceTypes)
                {
                    <option value="@type">@type</option>
                }
            </select>

            <button class="add-button" type="submit">Add Device</button>
        </form>

        <section class="panel demo-panel">
            <h2>Factory Method Demo</h2>
            <dl>
                <dt>Selected type</dt>
                <dd>@SmartHome.LastDemoInfo.SelectedType</dd>
                <dt>Selected Creator</dt>
                <dd>@SmartHome.LastDemoInfo.SelectedCreator</dd>
                <dt>Factory Method</dt>
                <dd>@SmartHome.LastDemoInfo.FactoryMethod</dd>
                <dt>Implementation</dt>
                <dd>@SmartHome.LastDemoInfo.Implementation</dd>
                <dt>Created Product</dt>
                <dd>@SmartHome.LastDemoInfo.CreatedProduct</dd>
                <dt>Returned as</dt>
                <dd>@SmartHome.LastDemoInfo.ReturnedAs</dd>
            </dl>
        </section>
    </section>

    <section class="devices-section">
        <h2>Devices</h2>
        @if (SmartHome.GetDevices().Count == 0)
        {
            <div class="empty-state">Add your first smart-home device to see the pattern in action.</div>
        }
        else
        {
            <div class="device-grid">
                @foreach (ISmartDevice device in SmartHome.GetDevices())
                {
                    @switch (device)
                    {
                        case GenericSmartDevice genericDevice:
                            <GenericSmartDeviceCard Device="genericDevice" OnRemove="RemoveDevice" />
                            break;
                        case SmartLight smartLight:
                            <SmartLightCard Device="smartLight" OnRemove="RemoveDevice" />
                            break;
                        case SmartPlug smartPlug:
                            <SmartPlugCard Device="smartPlug" OnRemove="RemoveDevice" />
                            break;
                        case Thermostat thermostat:
                            <ThermostatCard Device="thermostat" OnRemove="RemoveDevice" />
                            break;
                        case SmartFan smartFan:
                            <SmartFanCard Device="smartFan" OnRemove="RemoveDevice" />
                            break;
                    }
                }
            </div>
        }
    </section>

    <section class="panel pattern-panel">
        <h2>How Factory Method Works</h2>
        <div class="pattern-flow virtual-flow">
            <div class="pattern-node creator">SmartDeviceCreator<br /><span>virtual CreateDevice()</span></div>
            <div class="connector vertical"></div>
            <div class="pattern-node product">Default: GenericSmartDevice</div>
            <div class="connector vertical"></div>
            <div class="implementation-row">
                <div class="implementation-column">
                    <div class="implementation-label inherited">inherited</div>
                    <div class="pattern-node">BasicDeviceCreator</div>
                    <div class="connector vertical"></div>
                    <div class="pattern-node product">GenericSmartDevice</div>
                </div>
                <div class="implementation-column">
                    <div class="implementation-label overridden">overridden</div>
                    <div class="pattern-node">SmartLightCreator</div>
                    <div class="connector vertical"></div>
                    <div class="pattern-node product">SmartLight</div>
                </div>
                <div class="implementation-column">
                    <div class="implementation-label overridden">overridden</div>
                    <div class="pattern-node">SmartPlugCreator</div>
                    <div class="connector vertical"></div>
                    <div class="pattern-node product">SmartPlug</div>
                </div>
                <div class="implementation-column">
                    <div class="implementation-label overridden">overridden</div>
                    <div class="pattern-node">ThermostatCreator</div>
                    <div class="connector vertical"></div>
                    <div class="pattern-node product">Thermostat</div>
                </div>
                <div class="implementation-column">
                    <div class="implementation-label overridden">overridden</div>
                    <div class="pattern-node">SmartFanCreator</div>
                    <div class="connector vertical"></div>
                    <div class="pattern-node product">SmartFan</div>
                </div>
            </div>
            <div class="connector vertical"></div>
            <div class="pattern-node interface-node">returned as ISmartDevice</div>
        </div>
    </section>
</main>

@code {
    private string selectedDeviceType = "Basic Device";
    private string deviceName = string.Empty;

    protected override void OnInitialized()
    {
        selectedDeviceType = SmartHome.DeviceTypes.FirstOrDefault() ?? "Basic Device";
    }

    private void AddDevice()
    {
        string finalName = string.IsNullOrWhiteSpace(deviceName)
            ? selectedDeviceType
            : deviceName.Trim();

        SmartHome.AddDevice(selectedDeviceType, finalName);
        deviceName = string.Empty;
    }

    private void RemoveDevice(Guid id)
    {
        SmartHome.RemoveDevice(id);
    }
}
