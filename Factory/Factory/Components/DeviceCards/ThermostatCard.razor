@using Factory.Models

<article class="device-card thermostat-card">
    <div class="device-card-header">
        <div>
            <div class="device-title"><span class="device-icon">🌡️</span>@Device.Name</div>
            <div class="device-type">@Device.DeviceType</div>
        </div>
        <span class="status-pill @(Device.IsOn ? "on" : "off")">@(Device.IsOn ? "ON" : "OFF")</span>
    </div>

    <div class="temperature-grid">
        <div>
            <span>Current</span>
            <strong>@Device.CurrentTemperature.ToString("0.0") °C</strong>
        </div>
        <div>
            <span>Target</span>
            <strong>@Device.TargetTemperature.ToString("0.0") °C</strong>
        </div>
    </div>

    <div class="metric-row compact">
        <span>Mode</span>
        <strong>@Device.Mode</strong>
    </div>

    <div class="stepper">
        <button @onclick="Device.DecreaseTargetTemperature">-</button>
        <span>@Device.TargetTemperature.ToString("0.0") °C</span>
        <button @onclick="Device.IncreaseTargetTemperature">+</button>
    </div>

    <div class="card-actions">
        <button class="primary-action" @onclick="TogglePower">@(Device.IsOn ? "Turn Off" : "Turn On")</button>
        <button class="remove-action" @onclick="() => OnRemove.InvokeAsync(Device.Id)">Remove</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public Thermostat Device { get; set; } = default!;

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private void TogglePower()
    {
        if (Device.IsOn)
        {
            Device.TurnOff();
        }
        else
        {
            Device.TurnOn();
        }
    }
}
