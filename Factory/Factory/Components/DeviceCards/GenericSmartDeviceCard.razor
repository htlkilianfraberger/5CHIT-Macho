@using Factory.Models

<article class="device-card generic-card">
    <div class="device-card-header">
        <div>
            <div class="device-title"><span class="device-icon">⌂</span>@Device.Name</div>
            <div class="device-type">@Device.DeviceType</div>
        </div>
        <span class="status-pill @(Device.IsOn ? "on" : "off")">@(Device.IsOn ? "ON" : "OFF")</span>
    </div>

    <div class="metric-large">
        <span>Factory Method</span>
        <strong>Default</strong>
    </div>

    <p class="device-note">Created by the inherited SmartDeviceCreator.CreateDevice() implementation.</p>

    <div class="card-actions">
        <button class="primary-action" @onclick="TogglePower">@(Device.IsOn ? "Turn Off" : "Turn On")</button>
        <button class="remove-action" @onclick="() => OnRemove.InvokeAsync(Device.Id)">Remove</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public GenericSmartDevice Device { get; set; } = default!;

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private void TogglePower()
    {
        if (Device.IsOn)
        {
            Device.TurnOff();
        }
        else
        {
            Device.TurnOn();
        }
    }
}
