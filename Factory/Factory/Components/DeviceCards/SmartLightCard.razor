@using Factory.Models

<article class="device-card light-card">
    <div class="device-card-header">
        <div>
            <div class="device-title"><span class="device-icon">💡</span>@Device.Name</div>
            <div class="device-type">@Device.DeviceType</div>
        </div>
        <span class="status-pill @(Device.IsOn ? "on" : "off")">@(Device.IsOn ? "ON" : "OFF")</span>
    </div>

    <div class="metric-row">
        <span>Brightness</span>
        <strong>@Device.Brightness %</strong>
    </div>
    <div class="metric-row compact">
        <span>Color</span>
        <strong>@Device.ColorTemperature</strong>
    </div>

    <input class="range-control" type="range" min="0" max="100" step="5" @bind="Device.Brightness" @bind:event="oninput" />

    <div class="card-actions">
        <button class="primary-action" @onclick="TogglePower">@(Device.IsOn ? "Turn Off" : "Turn On")</button>
        <button class="remove-action" @onclick="() => OnRemove.InvokeAsync(Device.Id)">Remove</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public SmartLight Device { get; set; } = default!;

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private void TogglePower()
    {
        if (Device.IsOn)
        {
            Device.TurnOff();
        }
        else
        {
            Device.TurnOn();
        }
    }
}
