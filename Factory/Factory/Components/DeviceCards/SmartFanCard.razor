@using Factory.Models

<article class="device-card fan-card">
    <div class="device-card-header">
        <div>
            <div class="device-title"><span class="device-icon">🌀</span>@Device.Name</div>
            <div class="device-type">@Device.DeviceType</div>
        </div>
        <span class="status-pill @(Device.IsOn ? "on" : "off")">@(Device.IsOn ? "ON" : "OFF")</span>
    </div>

    <div class="metric-row">
        <span>Speed</span>
        <strong>@Device.Speed</strong>
    </div>

    <div class="speed-control" role="group" aria-label="Fan speed">
        @for (int speed = 1; speed <= 3; speed++)
        {
            int selectedSpeed = speed;
            <button class="@(Device.Speed == selectedSpeed ? "active" : null)" @onclick="() => Device.SetSpeed(selectedSpeed)">@selectedSpeed</button>
        }
    </div>

    <div class="card-actions">
        <button class="primary-action" @onclick="TogglePower">@(Device.IsOn ? "Turn Off" : "Turn On")</button>
        <button class="remove-action" @onclick="() => OnRemove.InvokeAsync(Device.Id)">Remove</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public SmartFan Device { get; set; } = default!;

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private void TogglePower()
    {
        if (Device.IsOn)
        {
            Device.TurnOff();
        }
        else
        {
            Device.TurnOn();
        }
    }
}
